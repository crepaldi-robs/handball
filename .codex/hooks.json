{
  "description": "Impede que modelos pagos executem ferramentas locais; a execucao pertence aos subagentes free_*.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/enforce_planner_policy.py\"",
            "commandWindows": "py -3 \"$(git rev-parse --show-toplevel)/.codex/hooks/enforce_planner_policy.py\"",
            "timeout": 30,
            "statusMessage": "Aplicando a politica planner pago / executor gratuito"
          }
        ]
      }
    ]
  }
}
